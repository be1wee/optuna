@startuml activity_suggest
!include common.iuml
title Trial._suggest: упрощённая схема\nДемо использует float; детали проверок и кэширования опущены
start
if (Параметр уже выбран в этой попытке?) then (да)
  :Вернуть сохранённое значение;
else (нет)
  if (Параметр зафиксирован?) then (да)
    :Взять фиксированное значение;
  elseif (В диапазоне одно значение?) then (да)
    :Взять единственное значение;
  else (выбор сэмплером)
    :Лениво вычислить relative_params:\ninfer_relative_search_space + sample_relative;
    if (Параметр есть в relative_params?) then (да)
      :Взять совместно выбранное значение;
    else (нет)
      :Вызвать sample_independent;
    endif
  endif
  :Сохранить параметр в Storage;
  :Вернуть значение;
endif
stop
@enduml
