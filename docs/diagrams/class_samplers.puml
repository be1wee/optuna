@startuml class_samplers
!include common.iuml
title Диаграмма классов (2): иерархия сэмплеров, композиция и точки расширения\n(упрощение: показаны 6 из 11 встроенных сэмплеров и только ключевые поля)

abstract class BaseSampler {
  + {abstract} infer_relative_search_space()
  + {abstract} sample_relative()
  + {abstract} sample_independent()
  + before_trial()
  + after_trial()
  + reseed_rng()
}
class RandomSampler {
  - _rng : LazyRandomState
  infer_relative_search_space() = {}
  sample_relative() = {}
}
class TPESampler {
  - _n_startup_trials = 10
  - _n_ei_candidates = 24
  - _gamma : Callable[[int], int]
  - _multivariate : bool | None
  - _group : bool
  - _constant_liar = True
  - _random_sampler : RandomSampler
  - _search_space : IntersectionSearchSpace
  - _parzen_estimator_cls = _ParzenEstimator
  - _sample(study, trial, search_space)
}
class _ParzenEstimator {
  + sample(rng, size)
  + log_pdf(samples)
}
class GPSampler {
  - _independent_sampler : BaseSampler = Random
  - _intersection_search_space
  - _optimize_acqf(acqf, best_params)
}
class CmaEsSampler {
  - _independent_sampler : BaseSampler = Random
  - _restore_optimizer() / system_attrs
}
class PartialFixedSampler {
  - _fixed_params : dict
  - _base_sampler : BaseSampler
}
class NSGAIISampler
class IntersectionSearchSpace {
  - _cached_trial_number : int
  + calculate(study, use_cache) : dict
}
class LazyRandomState {
  + rng : np.random.RandomState
}

package "демо-проект" {
  class LocalSearchSampler <<demo>> {
    - _independent_sampler : RandomSampler
    - _search_space : IntersectionSearchSpace
    - _radius : float
    + sample_relative(): окрестность best_trial
    + after_trial(): правило 1/5
  }
  class TracingSampler <<demo>> {
    - _base : BaseSampler
    логирует каждый вызов и делегирует
  }
}

BaseSampler <|-- RandomSampler
BaseSampler <|-- TPESampler
BaseSampler <|-- GPSampler
BaseSampler <|-- CmaEsSampler
BaseSampler <|-- PartialFixedSampler
BaseSampler <|-- NSGAIISampler
BaseSampler <|-- LocalSearchSampler
BaseSampler <|-- TracingSampler

RandomSampler *-- LazyRandomState
TPESampler *-- "1" RandomSampler : fallback при\nn < n_startup_trials
TPESampler *-- IntersectionSearchSpace
TPESampler ..> _ParzenEstimator : l(x), g(x)
GPSampler *-- IntersectionSearchSpace
PartialFixedSampler o-- "1" BaseSampler : base_sampler\n(Decorator)
TracingSampler o-- "1" BaseSampler : _base\n(Decorator)
LocalSearchSampler *-- RandomSampler
LocalSearchSampler *-- IntersectionSearchSpace
@enduml
