@startuml sequence
!include common.iuml
autonumber
title run.py: одна попытка optimize\nУпрощение: внутренние расчёты TPE и кэширование не показаны
participant "Код скрипта" as Script
participant Study
participant "_run_trial / _tell" as Loop
participant "objective\ncommon.py" as Objective
participant Trial
participant TracingSampler as Trace
participant "RandomSampler или TPESampler" as Sampler
database InMemoryStorage as Storage
Script -> Study : optimize(objective, n_trials=15)
Study -> Loop : запуск цикла
Loop -> Study : ask()
Study -> Storage : create_new_trial(...)
Study -> Trial : создать Trial
Trial -> Trace : before_trial(...)
Trace -> Sampler : before_trial(...)
Study --> Loop : trial
Loop -> Objective : objective(trial)
Objective -> Trial : suggest_float("x", -10, 10)
Trial -> Trace : infer_relative_search_space(...)
Trace -> Sampler : infer_relative_search_space(...)
Sampler --> Trace : пространство поиска
Trace --> Trial : пространство поиска
Trial -> Trace : sample_relative(...)
Trace -> Sampler : sample_relative(...)
Sampler --> Trace : параметры или {}
Trace --> Trial : параметры или {}
alt x выбран совместно
  Trial -> Trial : взять relative_params["x"]
else x не выбран совместно
  Trial -> Trace : sample_independent(..., "x", ...)
  Trace -> Sampler : sample_independent(...)
  Sampler --> Trace : x
  Trace --> Trial : x
end
Trial -> Storage : set_trial_param(..., "x", ...)
Trial --> Objective : x
Objective -> Trial : suggest_float("y", -10, 10)
note right of Trial
Используется уже вычисленный relative_params
или вызывается sample_independent для y.
Значение y тоже записывается в Storage.
end note
Trial --> Objective : y
Objective --> Loop : (x-2)^2 + (y+1)^2
Loop -> Trace : after_trial(..., COMPLETE, [value])
Trace -> Sampler : after_trial(...)
Loop -> Storage : set_trial_state_values(...)
@enduml
